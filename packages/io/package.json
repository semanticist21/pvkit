{
  "name": "@pvkit/io",
  "version": "0.1.1",
  "description": "PVGIS TMY and NASA POWER client for JavaScript: fetch solar irradiance (GHI, DNI, DHI) and weather for PV modeling, parsed like pvlib iotools. Zero dependencies, ESM, runs in the browser.",
  "type": "module",
  "license": "MIT",
  "author": "semanticist21",
  "homepage": "https://github.com/semanticist21/pvkit/tree/main/packages/io#readme",
  "bugs": {
    "url": "https://github.com/semanticist21/pvkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/semanticist21/pvkit.git",
    "directory": "packages/io"
  },
  "keywords": [
    "pvgis",
    "nasa-power",
    "tmy",
    "solar-irradiance",
    "irradiance",
    "ghi",
    "dni",
    "dhi",
    "weather",
    "solar-data",
    "pvlib",
    "photovoltaic",
    "pv",
    "solar",
    "typescript"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js",
      "./nasa-power": "./dist/nasa-power/index.js",
      "./pvgis-tmy": "./dist/pvgis-tmy/index.js",
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "tsdown"
  },
  "exports": {
    ".": "./src/index.ts",
    "./nasa-power": "./src/nasa-power/index.ts",
    "./pvgis-tmy": "./src/pvgis-tmy/index.ts",
    "./package.json": "./package.json"
  }
}
