{
  "name": "@pvkit/chain",
  "version": "0.1.0",
  "description": "Solar PV output in one call: pvlib-style ModelChain (PVWatts) for TypeScript/JavaScript. Site, system and weather in, AC power out. Runs in the browser.",
  "type": "module",
  "license": "MIT",
  "author": "semanticist21",
  "homepage": "https://github.com/semanticist21/pvkit/tree/main/packages/chain#readme",
  "bugs": {
    "url": "https://github.com/semanticist21/pvkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/semanticist21/pvkit.git",
    "directory": "packages/chain"
  },
  "keywords": [
    "pvwatts",
    "modelchain",
    "pvlib",
    "solar-power",
    "ac-power",
    "energy-yield",
    "solar-energy",
    "photovoltaic",
    "pv",
    "solar",
    "typescript"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js",
      "./model-chain": "./dist/model-chain/index.js",
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "tsdown"
  },
  "dependencies": {
    "@pvkit/core": "workspace:^"
  },
  "exports": {
    ".": "./src/index.ts",
    "./model-chain": "./src/model-chain/index.ts",
    "./package.json": "./package.json"
  }
}
