{
  "name": "@pvkit/spec",
  "version": "0.1.1",
  "description": "CEC solar module (PV panel) and inverter database plus Sandia SAPM modules from NREL SAM, as typed ESM data: 21,677 modules and 2,343 inverters.",
  "type": "module",
  "license": "MIT AND BSD-3-Clause",
  "author": "semanticist21",
  "homepage": "https://github.com/semanticist21/pvkit/tree/main/packages/spec#readme",
  "bugs": {
    "url": "https://github.com/semanticist21/pvkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/semanticist21/pvkit.git",
    "directory": "packages/spec"
  },
  "keywords": [
    "pv-module-database",
    "solar-panel-database",
    "inverter-database",
    "solar-inverter",
    "cec",
    "sandia",
    "sapm",
    "nrel-sam",
    "datasheet",
    "pvlib",
    "photovoltaic",
    "pv",
    "solar",
    "typescript"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./cec-inverters": "./src/cec-inverters/index.ts",
    "./cec-modules": "./src/cec-modules/index.ts",
    "./sandia-modules": "./src/sandia-modules/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js",
      "./cec-inverters": "./dist/cec-inverters/index.js",
      "./cec-modules": "./dist/cec-modules/index.js",
      "./sandia-modules": "./dist/sandia-modules/index.js",
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "tsdown"
  }
}
