{
  "name": "@pvkit/diode",
  "version": "0.1.1",
  "description": "Single-diode model and I-V curve solver for PV modules in plain ESM: De Soto / CEC / PVsyst parameters, Lambert-W, SAPM, Sandia and ADR inverters. Validated against pvlib. Zero dependencies.",
  "type": "module",
  "license": "MIT",
  "author": "semanticist21",
  "homepage": "https://github.com/semanticist21/pvkit/tree/main/packages/diode#readme",
  "bugs": {
    "url": "https://github.com/semanticist21/pvkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/semanticist21/pvkit.git",
    "directory": "packages/diode"
  },
  "keywords": [
    "single-diode",
    "iv-curve",
    "solar-cell",
    "sapm",
    "lambert-w",
    "inverter",
    "desoto",
    "cec",
    "pvsyst",
    "pvlib",
    "photovoltaic",
    "pv",
    "solar",
    "typescript"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js",
      "./calcparams-cec": "./dist/calcparams-cec/index.js",
      "./calcparams-desoto": "./dist/calcparams-desoto/index.js",
      "./calcparams-pvsyst": "./dist/calcparams-pvsyst/index.js",
      "./i-from-v": "./dist/i-from-v/index.js",
      "./inverter-adr": "./dist/inverter-adr/index.js",
      "./inverter-sandia": "./dist/inverter-sandia/index.js",
      "./sapm": "./dist/sapm/index.js",
      "./sapm-effective-irradiance": "./dist/sapm-effective-irradiance/index.js",
      "./sapm-spectral-factor": "./dist/sapm-spectral-factor/index.js",
      "./single-diode": "./dist/single-diode/index.js",
      "./v-from-i": "./dist/v-from-i/index.js",
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "tsdown"
  },
  "exports": {
    ".": "./src/index.ts",
    "./calcparams-cec": "./src/calcparams-cec/index.ts",
    "./calcparams-desoto": "./src/calcparams-desoto/index.ts",
    "./calcparams-pvsyst": "./src/calcparams-pvsyst/index.ts",
    "./i-from-v": "./src/i-from-v/index.ts",
    "./inverter-adr": "./src/inverter-adr/index.ts",
    "./inverter-sandia": "./src/inverter-sandia/index.ts",
    "./sapm": "./src/sapm/index.ts",
    "./sapm-effective-irradiance": "./src/sapm-effective-irradiance/index.ts",
    "./sapm-spectral-factor": "./src/sapm-spectral-factor/index.ts",
    "./single-diode": "./src/single-diode/index.ts",
    "./v-from-i": "./src/v-from-i/index.ts",
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@pvkit/spec": "workspace:*"
  }
}
